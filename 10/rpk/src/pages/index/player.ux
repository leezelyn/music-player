                class="body-text"
                if="{{receiving || !phoneReceiptText || uiTransferFailed}}"
              >
                {{ phoneText }}
              </text>
              <text
                class="body-text"
                if="{{phoneReceiptText && !receiving}}"
              >
                {{ phoneReceiptText }}
              </text>
