                class="action primary"
                if="{{hasPhoneSong && !receiving}}"
                @click="choosePhone"
              >
                <image
                  class="action-icon"
                  src="/common/icons/success.png"
                ></image>
                <text class="action-label primary-label">选择这首歌曲</text>
