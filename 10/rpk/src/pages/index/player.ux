              >
                <marquee
                  id="{{'library-title-' + $item.index}}"
                  class="song-card-title"
                  direction="left"
                  scrollamount="{{6}}"
                  loop="{{-1}}"
                  text-offset="{{50}}"
                  @click="chooseSong($item.index)"
                >
                  {{ $item.displayTitle }}
                </marquee>
                <div
                  class="song-plain-link"
                  @click="chooseSong($item.index)"
                >
                  <text class="song-hint">{{ $item.caption }}</text>
