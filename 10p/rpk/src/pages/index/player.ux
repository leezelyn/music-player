<template>
  <stack class="player-root">
    <div
      class="page"
      style="{{uiMenuWide ? 'padding:16px 4px;' : ''}}"
    >
      <div
        class="header"
        style="{{uiMenuWide ? 'margin-left:14px;' : ''}}"
      >
        <div
          class="header-home"
          if="{{uiScreen === 'home'}}"
          @click="uiConnectionDetails"
        >
          <div
            class="connection-dot"
            style="{{uiConnectionStyle}}"
          ></div>
          <text class="header-connection">{{ uiConnection }}</text>
        </div>
        <div
          class="back-entry"
          if="{{uiScreen !== 'home' && uiScreen !== 'disc'}}"
