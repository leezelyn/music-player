        >
          <image
            class="header-icon"
            src="/common/icons/settings.png"
          ></image>
        </div>
      </div>
      <div
        class="home"
        if="{{uiScreen === 'home'}}"
      >
        <div class="song-heading">
          <div
            class="title-shell"
            @click="uiDisc"
          >
            <text
              class="track-title"
              if="{{uiTitleUnavailable}}"
            >
              {{ uiTrackTitle }}
            </text>
            <marquee
              id="song-marquee"
              class="title-marquee"
              if="{{!uiTitleUnavailable}}"
              direction="left"
              scrollamount="{{6}}"
              loop="{{-1}}"
              text-offset="{{50}}"
            >
              {{ uiTrackTitle }}
            </marquee>
          </div>
        </div>
        <div
          class="lyric-button"
          @click="uiLyrics"
        >
          <marquee
            id="lyric-marquee"
            class="lyric-marquee"
            if="{{!uiLyricUnavailable}}"
            direction="left"
            scrollamount="{{3}}"
            loop="{{-1}}"
            text-offset="{{30}}"
          >
            {{ uiLyricLine }}
          </marquee>
          <text
            class="lyric-fallback"
            if="{{uiLyricUnavailable}}"
          >
            {{ uiLyricLine }}
          </text>
        </div>
        <div class="timeline">
          <div class="progress-rail">
            <div
              class="progress-fill"
              style="{{progressStyle}}"
            ></div>
          </div>
          <div class="time-row">
            <text class="time">{{ elapsedText }}</text>
            <text class="time time-end">{{ durationText }}</text>
          </div>
        </div>
        <div class="transport">
          <div
            class="volume-button"
            style="{{uiSkipStyle}}"
            @click="previous"
          >
            <image
              class="previous-icon"
              src="/common/icons/previous-user.png"
            ></image>
          </div>
          <div
            class="primary-button"
            @click="uiPrimary"
          >
            <div class="primary-disc">
              <image
                class="primary-icon"
                src="{{uiPrimaryIcon}}"
              ></image>
            </div>
          </div>
          <div
            class="volume-button"
            style="{{uiSkipStyle}}"
            @click="next"
          >
            <image
              class="next-icon"
              src="/common/icons/next.png"
            ></image>
          </div>
        </div>
        <div class="control-caption">
          <text class="volume-caption">{{ playOrderText }}</text>
          <text class="primary-caption">{{ uiPrimaryLabel }}</text>
        </div>
        <div
          class="status-button"
          @click="uiStatusDetails"
        >
          <text
            class="status-summary"
            style="{{uiStatusStyle}}"
          >
            {{ uiStatus }}
          </text>
        </div>
      </div>
      <div
        class="navigation"
        if="{{uiScreen === 'home'}}"
      >
        <div
          class="nav-button"
          @click="openSongs"
        >
          <image
            class="nav-icon"
            src="/common/icons/library.png"
          ></image>
          <text class="nav-label">歌曲</text>
        </div>
        <div
          class="nav-button"
          @click="uiTransfer"
        >
          <image
            class="nav-icon"
            src="/common/icons/phone.png"
          ></image>
          <text class="nav-label">传歌</text>
        </div>
      </div>
      <div
        class="record-page"
        if="{{uiScreen === 'disc'}}"
      >
        <div
          class="record-title-shell"
          @click="uiSongDetails"
        >
          <text
            class="record-title"
            if="{{uiTitleUnavailable}}"
          >
            {{ uiTrackTitle }}
          </text>
          <marquee
            id="disc-song-marquee"
            class="record-title-marquee"
            if="{{!uiTitleUnavailable}}"
            direction="left"
            scrollamount="{{6}}"
            loop="{{-1}}"
            text-offset="{{50}}"
          >
            {{ uiTrackTitle }}
          </marquee>
        </div>
        <div
          class="record-stage"
          @click="uiPrimary"
        >
          <image
            class="record-art"
            if="{{!uiDiscCoverUri}}"
            style="{{uiDiscStyle}}"
            src="/common/vinyl.png"
          ></image>
          <image
            class="record-song-cover"
            if="{{uiDiscCoverUri}}"
            style="{{uiDiscStyle}}"
            src="{{uiDiscCoverUri}}"
          ></image>
        </div>
        <div
          class="record-lyrics"
          @click="uiLyrics"
        >
          <text class="record-context">{{ uiDiscPrevious }}</text>
          <text class="record-current">{{ uiDiscCurrent }}</text>
          <text class="record-context">{{ uiDiscNext }}</text>
        </div>
        <div class="record-controls">
          <text class="record-time">{{ elapsedText }} / {{ durationText }}</text>
        </div>
      </div>
      <div
        class="scroll-shell"
        style="{{uiMenuWide ? 'width:328px;' : ''}}"
        if="{{uiScreen !== 'home' && uiScreen !== 'disc'}}"
      >
        <scroll
          id="content-scroll"
          class="content-scroll"
          style="{{uiMenuWide ? 'width:328px;' : ''}}"
          scroll-y="true"
          @scroll="onContentScroll"
          @scrolltop="onContentTop"
          @scrollbottom="onContentBottom"
        >
          <div
            class="scroll-content"
            style="{{uiMenuWide ? 'width:328px;' : ''}}"
          >
            <div
              class="section"
              if="{{uiScreen === 'library'}}"
            >
              <text class="section-note">手机歌曲 {{ phoneSongCount }} 首</text>
              <div
                class="song-entry"
                for="{{songs}}"
                tid="id"
              >
                <div
                  class="song-card"
                  style="{{$item.cardStyle}}"
                >
                  <marquee
                    id="{{'library-title-' + $item.index}}"
                    class="song-card-title"
                    direction="left"
                    scrollamount="{{6}}"
                    loop="{{-1}}"
                    text-offset="{{50}}"
                    @click="chooseSong($item.index)"
                  >
                    {{ $item.displayTitle }}
                  </marquee>
                  <div class="song-card-meta">
                    <text
                      class="song-card-caption"
                      @click="chooseSong($item.index)"
                    >
                      {{ $item.caption }}
                    </text>
                    <image
                      class="selected-icon"
                      if="{{$item.selected}}"
                      src="/common/icons/check.png"
                      @click="chooseSong($item.index)"
                    ></image>
                    <div
                      class="song-delete"
                      if="{{$item.deletable}}"
                      @click="requestDeleteSong($item.id)"
                    >
                      <image
                        class="song-delete-icon"
                        src="/common/icons/song-delete-system.png"
                      ></image>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="section"
                if="{{libraryPageCount > 1}}"
              >
                <text class="section-note">第 {{ libraryPageText }} 页</text>
                <div class="reader-actions">
                  <div
                    class="half-button"
                    if="{{libraryPage > 0}}"
                    @click="previousLibraryPage"
                  >
                    <text class="button-text secondary-text">上一页</text>
                  </div>
                  <div
                    class="half-button"
                    if="{{libraryPage + 1 < libraryPageCount}}"
                    @click="nextLibraryPage"
                  >
                    <text class="button-text secondary-text">下一页</text>
                  </div>
                </div>
              </div>
              <div
                class="row-card"
                @click="uiTransfer"
              >
                <text class="row-title">从手机传入歌曲</text>
                <image
                  class="row-icon"
                  src="/common/icons/phone.png"
                ></image>
              </div>
              <text
                class="body-note"
                if="{{!hasSelectedSong}}"
              >
                暂无歌曲，可从手机传入。
              </text>
              <text class="body-status">{{ statusText }}</text>
              <div
                class="wide-button"
                if="{{playing || paused}}"
                @click="stop"
              >
                <text class="button-text">停止播放</text>
              </div>
            </div>
            <div
              class="section"
              if="{{uiScreen === 'transfer'}}"
            >
              <div class="transfer-hero">
                <div class="transfer-disc">
                  <image
                    class="transfer-icon"
                    src="{{uiTransferIcon}}"
                  ></image>
                </div>
                <text class="transfer-title">{{ uiTransferTitle }}</text>
                <text class="transfer-progress">{{ uiTransferProgress }}</text>
              </div>
              <div
                class="wide-button secondary"
                if="{{receiving}}"
                @click="cancelTransfer"
              >
                <text class="button-text secondary-text">中断传输</text>
              </div>
              <div
                class="wide-button"
                if="{{hasPhoneSong && !receiving}}"
                @click="choosePhone"
              >
                <text class="button-text">选择这首歌曲</text>
              </div>
              <div
                class="wide-button secondary"
                if="{{playing || paused}}"
                @click="stop"
              >
                <text class="button-text secondary-text">先停止播放</text>
              </div>
              <div class="text-card">
                <text
                  class="body-text"
                  if="{{receiving || !phoneReceiptText || uiTransferFailed}}"
                >
                  {{ phoneText }}
                </text>
                <text
                  class="body-text"
                  if="{{phoneReceiptText && !receiving}}"
                >
                  {{ phoneReceiptText }}
                </text>
              </div>
              <div
                class="row-card"
                @click="openSongs"
              >
                <text class="row-title">打开歌曲清单</text>
                <image
                  class="row-icon"
                  src="/common/icons/library.png"
                ></image>
              </div>
            </div>
            <div
              class="section menu-section"
              if="{{uiScreen === 'settings'}}"
            >
              <text class="section-note menu-copy">播放与连接</text>
              <div
                class="row-card menu-row"
                @click="uiPlaybackSettings"
              >
                <text class="row-title menu-row-title">播放设置</text>
                <image
                  class="row-icon"
                  src="/common/icons/playback-settings.png"
                ></image>
              </div>
              <div
                class="row-card menu-row"
                @click="uiReadState"
              >
                <text class="row-title menu-row-title">播放状态</text>
                <image
                  class="row-icon"
                  src="/common/icons/info.png"
                ></image>
              </div>
              <div
                class="row-card menu-row"
                @click="uiConnectionDetails"
              >
                <text class="row-title menu-row-title">连接信息</text>
                <image
                  class="row-icon"
                  src="/common/icons/connection.png"
                ></image>
              </div>
              <div
                class="row-card menu-row"
                @click="uiHelp"
              >
                <text class="row-title menu-row-title">使用说明</text>
                <image
                  class="row-icon"
                  src="/common/icons/help.png"
                ></image>
              </div>

              <!-- prettier-ignore -->
              <text @click="uiLicense" class="body-note menu-copy">环间音乐 · {{appVersion}}
{{copyrightText}}
GPL-3.0-only · 无担保 · 点击查看许可</text>
              <div
                class="wide-button secondary menu-row"
                @click="exitApp"
              >
                <text class="button-text secondary-text">退出播放器</text>
              </div>
            </div>
            <div
              class="section menu-section"
              if="{{uiScreen === 'playback'}}"
            >
              <div
                class="row-card menu-row"
                @click="uiToggleAwake"
              >
                <div class="awake-copy">
                  <text class="awake-title">屏幕常亮</text>
                  <text class="awake-state">{{ uiAwakeText }}</text>
                </div>
                <div
                  class="awake-toggle"
                  style="{{uiAwakeEnabled ? 'background-color:#bac3ff;justify-content:flex-end;' : ''}}"
                >
                  <div class="awake-knob"></div>
                </div>
              </div>
              <text class="section-note menu-copy">音量 {{ volumeText }}</text>
              <div class="settings-volume-row">
                <div
                  class="volume-button"
                  style="{{uiVolumeStyle}}"
                  @click="volumeDown"
                >
                  <image
                    class="volume-icon"
                    src="/common/icons/minus.png"
                  ></image>
                </div>
                <text class="settings-volume-value">{{ volumeText }}</text>
                <div
                  class="volume-button"
                  style="{{uiVolumeStyle}}"
                  @click="volumeUp"
                >
                  <image
                    class="volume-icon"
                    src="/common/icons/plus.png"
                  ></image>
                </div>
              </div>
              <div
                class="wide-button secondary menu-row"
                if="{{playing || paused || switching}}"
                @click="stop"
              >
                <text class="button-text secondary-text">停止播放</text>
              </div>
              <text class="section-note menu-copy">播放顺序 · {{ playOrderText }}</text>
              <div
                class="row-card menu-row"
                @click="setPlayOrder('sequential')"
              >
                <text class="row-title menu-row-title">顺序播放</text>
                <image
                  class="row-icon"
                  if="{{playOrder === 'sequential'}}"
                  src="/common/icons/check.png"
                ></image>
              </div>
              <div
                class="row-card menu-row"
                @click="setPlayOrder('list')"
              >
                <text class="row-title menu-row-title">列表循环</text>
                <image
                  class="row-icon"
                  if="{{playOrder === 'list'}}"
                  src="/common/icons/check.png"
                ></image>
              </div>
              <div
                class="row-card menu-row"
                @click="setPlayOrder('single')"
              >
                <text class="row-title menu-row-title">单曲循环</text>
                <image
                  class="row-icon"
                  if="{{playOrder === 'single'}}"
                  src="/common/icons/check.png"
                ></image>
              </div>
              <div
                class="row-card menu-row"
                @click="setPlayOrder('shuffle')"
              >
                <text class="row-title menu-row-title">随机播放</text>
                <image
                  class="row-icon"
                  if="{{playOrder === 'shuffle'}}"
                  src="/common/icons/check.png"
                ></image>
              </div>
              <text class="body-status menu-copy">{{ statusText }}</text>
            </div>

            <div
              class="section"
              if="{{uiScreen === 'lyrics'}}"
            >
              <text class="reader-text">{{ uiLyricsText }}</text>
            </div>
            <div
              class="section"
              if="{{uiScreen === 'reader'}}"
            >
              <text
                class="reader-text"
                style="{{uiReaderKind === 'help' ? 'opacity:0.65;' : ''}}"
              >
                {{ uiReaderText }}
              </text>

              <div
                class="wide-button secondary"
                if="{{playing || paused}}"
                @click="stop"
              >
                <text class="button-text secondary-text">停止播放</text>
              </div>
            </div>
            <div class="scroll-end"></div>
          </div>
        </scroll>
        <div
          class="scroll-track"
          style="{{uiMenuWide ? 'width:2px;right:-3px;' : ''}}"
          if="{{uiScrollVisible}}"
        >
          <div
            class="scroll-fill"
            style="{{uiScrollStyle + (uiMenuWide ? 'width:2px;' : '')}}"
          ></div>
        </div>
      </div>
    </div>
    <div
      class="exit-notice"
      if="{{uiExitNotice}}"
    >
      <text class="exit-notice-text">{{ uiExitNotice }}</text>
    </div>
    <div
      class="delete-overlay"
      if="{{deleteSongId}}"
    >
      <div class="delete-dialog">
        <text class="delete-heading">删除这首歌曲？</text>
        <scroll
          class="delete-name-scroll"
          scroll-y="true"
        >
          <text class="delete-name">{{ deleteSongTitle }}</text>
        </scroll>
        <scroll
          class="delete-note-scroll"
          scroll-y="true"
        >
          <text class="delete-note">{{ deleteNote }}</text>
        </scroll>
        <div
          class="delete-confirm"
          @click="confirmDeleteSong"
        >
          <text class="delete-action-text">{{ deletingSong ? '正在删除' : '确认删除' }}</text>
        </div>
        <div
          class="delete-cancel"
          @click="cancelDeleteSong"
        >
          <text class="delete-action-text">取消</text>
        </div>
      </div>
    </div>
  </stack>
</template>
<script>
// SPDX-License-Identifier: GPL-3.0-only
