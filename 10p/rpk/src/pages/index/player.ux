        >
          <div class="back-button">
            <image
              class="back-icon"
              src="/common/icons/back.png"
            ></image>
          </div>
          <text class="header-title">{{ uiHeader }}</text>
        </div>
        <text
          class="record-header"
          if="{{uiScreen === 'disc'}}"
        >
          {{ uiHeader }}
        </text>
        <div
          class="minimize-button"
          if="{{uiScreen === 'disc'}}"
          @click="uiHome"
        >
          <image
            class="minimize-icon"
            src="/common/icons/minimize.png"
          ></image>
        </div>
        <div
          class="settings-button"
          if="{{uiScreen === 'home'}}"
